 *
 * KEYPOINT programmer 60% base layer.
 * All normal ANSI punctuation used for programming is directly reachable
 * on layer 0. No bracket/minus/quote/backslash key is hidden behind a layer.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/rgb.h>
#include <behaviors/mouse_key_toggle.dtsi>

#define LOWER 1
#define RAISE 2
#define MOUSE 3
#define BOT bootloader

/ {
    behaviors {
        td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <400>;
            bindings = <&mkp LCLK>, <&bt BT_CLR>;
        };

        tdRMCLK: tap_dance_R_LMouse {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <400>;
            bindings = <&mkp RCLK>, <&mkp MCLK>;
        };

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <500>;
            bindings = <&kp &kp>;
        };

        LMouse_sc: behavior_LMouse_Scroll {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&none &mkp>;
        };

        M_kp: behavior_mouse_keypress {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mkp &kp>;
        };

        BLE_encoder: BLE_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&bt BT_NXT>, <&bt BT_PRV>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /*
         * Conventional ANSI-60-style programming layer.
         *
         * Esc  1 2 3 4 5 | 6 7 8 9 0 - = Backspace
         * Tab  Q W E R T | Y U I O P [ ] \
         * Caps A S D F G | H J K L ; ' Enter
         * Shift Z X C V B| N M , . / Shift
         * Ctrl GUI Alt Space | RAlt Fn RGUI RCtrl
         *
         * KEYPOINT extras after the ANSI positions:
         * Grave/Tilde, second Space, LClick, RClick,
         * Scroll-mod, Arrow-mod, Slow-pointer-mod.
         */
        default_layer {
            display-name = "PROGRAMMER";
            bindings = <
/* row 0 */
&kp ESC   &kp N1    &kp N2    &kp N3    &kp N4    &kp N5    &kp N6    &kp N7    &kp N8    &kp N9    &kp N0    &kp MINUS &kp EQUAL &kp BSPC
/* row 1 */
&kp TAB   &kp Q     &kp W     &kp E     &kp R     &kp T     &kp Y     &kp U     &kp I     &kp O     &kp P     &kp LBKT  &kp RBKT  &kp BSLH
/* row 2 */
&kp CAPS  &kp A     &kp S     &kp D     &kp F     &kp G     &kp H     &kp J     &kp K     &kp L     &kp SEMI  &kp SQT   &kp ENTER
/* row 3 */
&kp LSHFT &kp Z     &kp X     &kp C     &kp V     &kp B     &kp N     &kp M     &kp COMMA &kp DOT   &kp FSLH  &kp RSHFT
/* bottom */
&kp LCTRL &kp LGUI  &kp LALT  &kp SPACE &kp RALT  &mo 1     &kp RGUI  &kp RCTRL
/* KEYPOINT extras */
&kp GRAVE &kp SPACE &mkp LCLK &mkp RCLK &none     &none     &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp LEFT RIGHT>;
        };

        lower_layer {
            display-name = "FN";
            bindings = <
/* row 0: F row */
&kp GRAVE &kp F1    &kp F2    &kp F3    &kp F4    &kp F5    &kp F6    &kp F7    &kp F8    &kp F9    &kp F10   &kp F11   &kp F12   &kp DEL
/* row 1 */
&trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &kp UP    &trans    &trans    &trans    &trans    &trans
/* row 2 */
&trans    &trans    &trans    &trans    &trans    &trans    &trans    &kp LEFT  &kp DOWN  &kp RIGHT &trans    &trans    &trans
/* row 3 */
&trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans
/* bottom */
&trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans
/* extras */
&trans    &trans    &mkp MCLK &mkp RCLK &none     &none     &none
            >;
            sensor-bindings = <&BLE_encoder &inc_dec_kp UP DOWN>;
        };

        raise_layer {
            display-name = "SYSTEM";
            bindings = <
/* row 0 */
&trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans
/* row 1 */
&trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans
/* row 2 */
&trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans
/* row 3 */
&trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans
/* bottom */
&trans    &trans    &BOT      &bt BT_CLR &trans   &trans    &out OUT_TOG &trans
/* extras */
&trans    &trans    &trans    &trans    &none     &none     &none
            >;
        };

        MOUSE_layer {
            display-name = "MOUSE";
            bindings = <
/* Keep the entire normal typing surface transparent so mouse-layer activation
 * never hides punctuation or letters from the programmer base layer. */
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &mkp LCLK &mkp RCLK &none &none &none
            >;
        };

        RES_layer {
            display-name = "RESERVE";
            bindings = <
&none &none &none &none &none &none &none &none &none &none &none &none &none &none
&none &none &none &none &none &none &none &none &none &none &none &none &none &none
&none &none &none &none &none &none &none &none &none &none &none &none &none
&none &none &none &none &none &none &none &none &none &none &none &none
&none &none &none &none &none &none &none &none
&none &none &none &none &none &none &none
            >;
        };
    };
};
