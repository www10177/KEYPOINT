/dts-v1/;
#include <nordic/nrf52840_qiaa.dtsi>

#include <dt-bindings/led/led.h>
#include <dt-bindings/zmk/matrix_transform.h>
#include "zitaotech_keypoint-layouts.dtsi"


/ {
    model = "zitaotech_keypoint";
    compatible = "ZitaoTech,zitaotech-keypoint";

    chosen {
        zephyr,code-partition = &code_partition;
        zephyr,sram = &sram0;
        zephyr,flash = &flash0;
        zephyr,console = &cdc_acm_uart;
        zmk,kscan = &kscan0;
        zmk,physical-layouts = &zitaotech_keypoint_layout;
        zmk,studio-rpc-uart = &cdc_acm_uart;
    };

    /*
     * Programmer-oriented 60% class layout.
     *
     * Logical order follows a conventional ANSI 60% base layer first:
     *   14-key number row
     *   14-key Q row
     *   13-key A row
     *   12-key Z row
     *    8-key modifier row
     *
     * Then seven KEYPOINT extras are appended:
     *   Grave/Tilde, second Space, L/R mouse click,
     *   pointer-scroll modifier, pointer-arrow modifier, slow-pointer modifier.
     *
     * A strict 61-key 60% normally multiplexes Grave/Escape on many boards.
     * This variant keeps BOTH directly accessible on layer 0 for programming.
     *
     * No additional MCU GPIOs are required: all added switches use otherwise
     * unused intersections of the existing 6x8 matrix on each half.
     */
    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <16>;
        rows = <6>;
        map = <
/* ANSI row 0: Esc 1 2 3 4 5 | 6 7 8 9 0 - = Backspace */
RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)   RC(0,8) RC(0,9) RC(0,10) RC(0,11) RC(0,12) RC(0,13) RC(0,14) RC(0,15)
/* ANSI row 1: Tab Q W E R T | Y U I O P [ ] \ */
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)   RC(1,8) RC(1,9) RC(1,10) RC(1,11) RC(1,12) RC(1,13) RC(1,14) RC(1,15)
/* ANSI row 2: Caps A S D F G | H J K L ; ' Enter */
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)   RC(2,8) RC(2,9) RC(2,10) RC(2,11) RC(2,12) RC(2,13) RC(2,14)
/* ANSI row 3: LShift Z X C V B | N M , . / RShift */
RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5)   RC(3,8) RC(3,9) RC(3,10) RC(3,11) RC(3,12) RC(3,13)
/* ANSI-style bottom row: LCtrl LGUI LAlt Space | RAlt Fn RGUI RCtrl */
RC(4,0) RC(4,1) RC(4,2) RC(4,3)                   RC(4,8) RC(4,9) RC(4,10) RC(4,11)
/* KEYPOINT extras */
RC(4,4) RC(4,12) RC(5,6) RC(5,14) RC(4,6) RC(4,7) RC(4,15)
        >;
    };

left_encoder: encoder_left {
        compatible = "alps,ec11";
        a-gpios = <&gpio0 14 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
        b-gpios = <&gpio0 11 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
        resolution = <4>;
        steps = <20>;
        status = "disabled";
     };

right_encoder: encoder_right {
        compatible = "alps,ec11";
        a-gpios = <&gpio0 26 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
        b-gpios = <&gpio0 4 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
        resolution = <4>;
        steps = <20>;
        status = "disabled";
     };

     sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&left_encoder &right_encoder>;
        triggers-per-rotation = <5>;
    };

};


&usbd {
    status = "okay";
    cdc_acm_uart: cdc_acm_uart {
        compatible = "zephyr,cdc-acm-uart";
    };
};

&zitaotech_keypoint_layout{
    transform = <&default_transform>;
    kscan = <&kscan0>;
};

zephyr_udc0: &usbd {
    compatible = "nordic,nrf-usbd";
    status = "okay";
};

&flash0 {
    partitions {
        compatible = "fixed-partitions";
        #address-cells = <1>;
        #size-cells = <1>;

        sd_partition: partition@0 {
            reg = <0x00000000 0x00001000>;
        };

        code_partition: partition@1000 {
            reg = <0x00001000 0x000d3000>;
        };

        storage_partition: partition@d4000 {
            reg = <0x000d4000 0x00020000>;
        };

        boot_partition: partition@f4000 {
            reg = <0x000f4000 0x0000c000>;
        };
    };
};
